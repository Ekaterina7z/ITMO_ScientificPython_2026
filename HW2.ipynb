    "import requests\n",
    "import json\n",
    "import re\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def http_function(endpoint, **kwargs):\n",
    "    response = requests.get(endpoint, **kwargs)\n",
    "    return response\n",
    "\n",
    "def get_uniprot(accession):\n",
    "    endpoint = f\"https://rest.uniprot.org/uniprotkb/{accession}.json\"\n",
    "    http_args = {}\n",
    "    return http_function(endpoint, **http_args)\n",
    "\n",
    "def uniprot_parse_response(resp: dict):\n",
    "    try:\n",
    "        accession = resp.get(\"primaryAccession\")\n",
    "    except Exception:\n",
    "        accession = None\n",
    "    \n",
    "    organism = resp.get(\"organism\", {}).get(\"scientificName\")\n",
    "    geneInfo = resp.get(\"genes\", [])\n",
    "    sequenceInfo = resp.get(\"sequence\", {})\n",
    "    type_ = resp.get(\"entryType\")\n",
    "\n",
    "    output = {\n",
    "        accession: {\n",
    "            \"organism\": organism,\n",
    "            \"geneInfo\": geneInfo,\n",
    "            \"sequenceInfo\": sequenceInfo,\n",
    "            \"type\": type_\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    return output\n",
    "\n",
    "def get_ensembl(id):\n",
    "  \n",
    "  endpoint = f\"https://rest.ensembl.org/lookup/id/{id}\"\n",
    "  http_args = {\n",
    "        \"headers\": {\"Content-Type\": \"application/json\"}\n",
    "    }\n",
    "  return http_function(endpoint, **http_args)\n",
    "\n",
    "\n",
    "def ensembl_parse_response(resp: dict):\n",
    "    \n",
    "    try:\n",
    "        id = resp[\"id\"]\n",
    "    except KeyError:\n",
    "        id = None\n",
    "\n",
    "    object_type = resp.get(\"object_type\")\n",
    "    assembly_name = resp.get(\"assembly_name\")\n",
    "    species = resp.get(\"species\")\n",
    "    db_type = resp.get(\"db_type\")\n",
    "    biotype = resp.get(\"biotype\")\n",
    "    display_name = resp.get(\"display_name\")\n",
    "    id = resp.get(\"id\")\n",
    "    description = resp.get(\"description\")\n",
    "    canonical_transcript = resp.get(\"canonical_transcript\")\n",
    "    source = resp.get(\"source\")\n",
    "  \n",
    "    output = {\n",
    "        id: {\n",
    "            \"object_type\": object_type,\n",
    "            \"species\": species,\n",
    "            \"assembly_name\": assembly_name,\n",
    "            \"biotype\": biotype,\n",
    "            \"display_name\": display_name,\n",
    "            \"id\": id,\n",
    "            \"db_type\": db_type,\n",
    "            \"description\": description,\n",
    "            \"source\": source,\n",
    "            \"canonical_transcript\": canonical_transcript\n",
    "        }\n",
    "    }\n",
    "  \n",
    "    return output\n",
    "\n",
    "\n",
    "def main(ids: list):\n",
    "    output = {}\n",
    "\n",
    "    for id_ in ids:\n",
    "        try:\n",
    "            # Ensembl\n",
    "            if id_.startswith(\"ENS\"):\n",
    "                resp = get_ensembl(id_)\n",
    "                resp.raise_for_status()\n",
    "                parsed = ensembl_parse_response(resp.json())\n",
    "\n",
    "            # UniProt\n",
    "            elif id_[0].isalpha():\n",
    "                resp = get_uniprot(id_)\n",
    "                resp.raise_for_status()\n",
    "                parsed = uniprot_parse_response(resp.json())\n",
    "\n",
    "            else:  # Unknown database\n",
    "                output[id_] = {\"error\": \"unknown database\"}\n",
    "                continue    \n",
    "\n",
    "            inner_key = list(parsed.keys())[0]\n",
    "            output[id_] = parsed[inner_key]  \n",
    "\n",
    "        except requests.exceptions.HTTPError:\n",
    "            output[id_] = {"error": f"ID {id_} not found"}\"\n",
    "        except Exception as e:\n",
    "            output[id_] = {"error": str(e)}\"\n",
    "        df = pd.DataFrame.from_dict(output, orient="index")\"\n",
    "\n",
    "    return df"
   ]
  }
